{
  "desc": "不做 Action 校验，直接使用 raw action，同时输出 Lite 综合任务完成度与轨迹全图正确性（并集字段）。",
  "examples": [
    "python main.py data/your_tasks.jsonl --pipeline-json pipeline/pipeline_lite_action_trajectory_allimg.json --model doubao-seed-1.8 --no-qa",
    "python test_service.py --pipeline-json pipeline/pipeline_lite_action_trajectory_allimg.json",
    "python main.py data/your_tasks.jsonl --eval-profile lite_action+trajectory_allimg --model doubao-seed-1.8 --no-qa"
  ],
  "preset": "lite_action+trajectory_allimg",
  "eval_lite_mode": true,
  "output_lite_mode": false,
  "final_judgment_mode": "lite_plus_trajectory_all_images",
  "lite_include_action_list": true,
  "lite_action_chain_source": "raw",
  "unified_scope": "lite_end_only",
  "use_keyframe_images": true,
  "use_qa_images": false,
  "no_qa": true,
  "skip_takeover": true,
  "compress_quality": 0.6
}
