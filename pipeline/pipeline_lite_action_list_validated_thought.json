{
  "desc": "Lite 快路径中使用校验后的 action，并在 prompt 中附加意图-操作链；接管接续（Auto任务继续/外部模型接管）优先使用原始 thought，为空时使用默认兜底文案。",
  "examples": [
    "python main.py data/your_tasks.jsonl --pipeline-json pipeline/pipeline_lite_action_validated_thought.json --model doubao-seed-1.8 --no-qa",
    "python test_service.py --pipeline-json pipeline/pipeline_lite_action_validated_thought.json",
    "python main.py data/your_tasks.jsonl --eval-profile lite_action_validated_thought --model doubao-seed-1.8 --no-qa"
  ],
  "preset": "lite_action_validated_thought",
  "eval_lite_mode": true,
  "output_lite_mode": true,
  "final_judgment_mode": "unified_single",
  "lite_include_action_list": true,
  "lite_action_chain_source": "validated_thought",
  "unified_scope": "lite_end_only",
  "use_keyframe_images": false,
  "use_qa_images": false,
  "no_qa": true,
  "skip_takeover": true,
  "compress_quality": 0.6
}
